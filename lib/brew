#!/bin/bash

run_brew() {
    # Check for Homebrew
    if type_exists 'brew'; then
        e_header "Updating Homebrew..."
        # Use the latest version of Homebrew
        brew update
        [[ $? ]] && e_success "Done"

        e_header "Updating any existing Homebrew formulae..."
        # Upgrade any already-installed formulae
        brew upgrade
        [[ $? ]] && e_success "Done"

        # GNU `sed` is installed via the desired_formulae loop below.

        # font tools.
        brew tap bramstein/webfonttools

        # disable macos apache before install
        sudo apachectl stop 2>/dev/null || true
        sudo launchctl unload -w /System/Library/LaunchDaemons/org.apache.httpd.plist 2>/dev/null

        if ! formula_exists httpd; then
            brew install httpd
        fi
        # httpd is started/configured in run_postinstall (lib/post-install)

        e_header "Checking status of desired Homebrew formulae..."
        local list_formulae
        local -a missing_formulae
        # Snapshot of `brew leaves` mirrored back into the dotfiles.
        # TODO markers flag formulae that look unused / candidates for removal
        # (based on install date == last bin atime, or known-stale tools).
        # Review periodically: `brew leaves` vs this list.
        local -a desired_formulae=(
            # GNU core utilities (those that come with OS X are outdated)
            'coreutils'
            'moreutils'
            'findutils'
            'gnu-sed'
            'grep'

            # fun
            'cmatrix'

            # git
            'git'
            'git-lfs'
            'git-extras'
            'git-secret'
            'diff-so-fancy'
            'gh'
            'commitizen'
            'bfg'

            # font tools
            'bramstein/webfonttools/sfnt2woff'
            'bramstein/webfonttools/sfnt2woff-zopfli'
            'woff2'

            # system
            'openssh'
            'dnsmasq'
            'mkcert'
            'nss'
            'binutils'
            'binwalk' # TODO: stale? rarely used
            'mtr'

            # shell / cli
            'ack'
            'zsh'
            'bash'
            'bash-completion'
            'tree'
            'wget'
            'screen'
            'zoxide'
            'fzf'
            'fd'
            'bat'
            'fnm'
            'hexyl'
            'pastel'
            'dprint'
            'ripgrep'
            'neovim'
            'fx'
            'rename' # http://plasmasturm.org/code/rename/
            'rsync'
            'ssh-copy-id'
            'grex'
            'cheat' # TODO: stale?
            'wtfutil' # TODO: stale?

            # dev languages / runtimes
            'go'
            'python@3.11'
            'hugo'
            'oven-sh/bun/bun'
            #'maven'
            'node'
            # 'php'             # dropped — no longer used locally
            # 'python@3.9'      # TODO: EOL, remove?
            # 'openjdk@11'      # TODO: superseded by temurin@21 cask, remove?

            # JS package managers
            'yarn'
            'pnpm'
            'ni'
            'vite-plus'
            # 'egoist/tap/dum'  # TODO: unused since 2021, remove?

            # data / infra
            'mariadb'         # TODO: still needed?
            'redis'           # TODO: still needed?
            'mongodb/brew/mongodb-community'
            'httpd'
            'nginx'           # TODO: have httpd, drop one?
            'sops'
            'trivy'
            # 'terraform'      # TODO: stale since 2023, remove?
            # 'sonarqube'      # TODO: stale, remove?

            # cloud / auth
            'awscli'
            'azure-cli'
            'saml2aws'
            'docker-credential-helper-ecr'

            # security / web testing
            'testssl'
            # 'siege'          # TODO: stale, remove?
            # 'wrk'            # TODO: stale, remove?

            # ci / automation
            'act'

            # python tooling
            'pipenv'          # TODO: still needed?
            'docutils'
            'numpy'           # TODO: prefer venv?
            'pillow'          # TODO: prefer venv?

            # build deps (kept for compatibility)
            'gobject-introspection'
            'libass'
            'libbluray'
            'libmemcached'
            'libraw'
            'tcl-tk'

            # media
            'ffmpeg'
            'imagemagick'
            'gifsicle'
            'graphicsmagick'
            'optipng'
            'zopfli'
            'tesseract'
            # 'youtube-dl'     # TODO: deprecated, switch to yt-dlp?

            # cms / cli
            'contentful-cli'

            # one-offs
            'vldmrkl/formulae/airdrop-cli' # TODO: unused since 2022?
        )

        local -a failed_formulae=()
        for index in ${!desired_formulae[*]}; do
            if ! formula_exists ${desired_formulae[$index]}; then
                missing_formulae+=("${desired_formulae[$index]}")
                e_header "Installing missing Homebrew formula: ${desired_formulae[$index]}"
                if ! brew install "${desired_formulae[$index]}"; then
                    e_warning "Failed to install: ${desired_formulae[$index]}"
                    failed_formulae+=("${desired_formulae[$index]}")
                fi
            fi
        done
        if [[ ${#failed_formulae[@]} -gt 0 ]]; then
            e_warning "Skipped (review lib/brew): ${failed_formulae[*]}"
        fi

        # Remove outdated versions from the Cellar
        brew cleanup
    else
        printf "\n"
        e_error "Error: Homebrew not found."
        printf "Aborting...\n"
        exit
    fi

}
