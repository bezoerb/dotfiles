#!/bin/bash

run_postinstall() {

    # Make sure the sudo token is fresh before we start a long block of
    # mixed user/sudo commands. Prompts here would interrupt the flow.
    sudo -v

    BREW_PREFIX="$(brew --prefix)"

    # Remove the quarantine attribute for quicklook plugins (best-effort)
    xattr -dr com.apple.quarantine ~/Library/QuickLook 2>/dev/null || true

    # ----- oh-my-zsh -----
    if [[ ! -d "${HOME}/.oh-my-zsh" ]]; then
        e_header "Installing oh-my-zsh..."
        RUNZSH=no KEEP_ZSHRC=yes \
            sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
        [[ $? ]] && e_success "Done"
    fi

    # use sindres pure theme (oh-my-zsh looks in custom/themes/ for ZSH_THEME)
    mkdir -p "${HOME}/.oh-my-zsh/custom/themes"
    rsync -avz --quiet "${DOTFILES_DIRECTORY}/shell/pure.zsh-theme" \
        "${HOME}/.oh-my-zsh/custom/themes/pure.zsh-theme"

    # zsh-z plugin (idempotent)
    ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}"
    if [[ ! -d "${ZSH_CUSTOM_DIR}/plugins/zsh-z" ]]; then
        git clone https://github.com/agkozak/zsh-z "${ZSH_CUSTOM_DIR}/plugins/zsh-z"
    fi

    # set zsh as default shell
    ZSH_BIN="$(which zsh)"
    if [[ "${SHELL}" != "${ZSH_BIN}" ]]; then
        # chsh refuses shells not listed in /etc/shells ("non-standard shell")
        if ! grep -qxF "${ZSH_BIN}" /etc/shells; then
            echo "${ZSH_BIN}" | sudo tee -a /etc/shells >/dev/null
        fi
        # Use `sudo chsh` so the cached sudo token is reused instead of
        # prompting for the user password again.
        sudo chsh -s "${ZSH_BIN}" "${USER}"
    fi

    # ----- mkcert local CA -----
    mkcert -install

    # ----- httpd (static webserver for ~/Sites) -----
    e_header "Configure apache/httpd"

    # If a previous run left a broken launch agent registered, remove it so
    # `brew services start` can bootstrap cleanly ("Input/output error" = 5).
    launchctl bootout "gui/$(id -u)/homebrew.mxcl.httpd" 2>/dev/null || true
    rm -f "${HOME}/Library/LaunchAgents/homebrew.mxcl.httpd.plist" 2>/dev/null || true

    # start now and on login (user-scope; do NOT use sudo)
    brew services start httpd
    [[ $? ]] && e_success "httpd service started"
    apacheConf=$(httpd -V 2>/dev/null | awk -F'"' '/SERVER_CONFIG_FILE/{print $2}')
    if [[ -z "${apacheConf}" ]]; then
        apacheConf="${BREW_PREFIX}/etc/httpd/httpd.conf"
    fi
    mkdir -p "$(dirname "${apacheConf}")/sites-enabled"
    mkdir -p "${HOME}/Sites"

    # Enable common modules (no PHP). BSD sed needs the `-i ''` form.
    sudo sed -i '' -e "/LoadModule rewrite_module/s/^#//"          "${apacheConf}"
    sudo sed -i '' -e "/LoadModule deflate_module/s/^#//"          "${apacheConf}"
    sudo sed -i '' -e "/LoadModule expires_module/s/^#//"          "${apacheConf}"
    sudo sed -i '' -e "/LoadModule ssl_module/s/^#//"              "${apacheConf}"
    sudo sed -i '' -e "/LoadModule http2_module/s/^#//"            "${apacheConf}"
    sudo sed -i '' -e "/LoadModule socache_shmcb_module/s/^#//"    "${apacheConf}"
    sudo sed -i '' -e "/LoadModule vhost_alias_module/s/^#//"      "${apacheConf}"
    sudo sed -i '' -e "/httpd-ssl.conf/s/^#//"                     "${apacheConf}"
    sudo sed -i '' -e "s|/usr/local/var/www/htdocs|${HOME}/Sites|g" "${apacheConf}"
    sudo sed -i '' -E "s/^Listen 80[0-9]+/Listen 80/g"             "${apacheConf}"
    sudo sed -i '' -e "s/User daemon/User _www/g"                  "${apacheConf}"
    sudo sed -i '' -e "s/Group daemon/Group _www/g"                "${apacheConf}"
    sudo sed -i '' -E "s/^#?ServerName .*/ServerName localhost/"    "${apacheConf}"

    # Generate a self-signed cert for SSL vhost if missing, otherwise httpd
    # refuses to start ("SSLCertificateFile ... does not exist").
    httpdEtc="$(dirname "${apacheConf}")"
    if [[ ! -s "${httpdEtc}/server.crt" || ! -s "${httpdEtc}/server.key" ]]; then
        sudo openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
            -keyout "${httpdEtc}/server.key" \
            -out    "${httpdEtc}/server.crt" \
            -subj "/CN=localhost" >/dev/null 2>&1 || true
    fi

    sudo apachectl -k restart
    [[ $? ]] && e_success "httpd configured"

    # ----- git-friendly -----
    e_header "Adding git-friendly..."
    # The upstream installer hard-codes /usr/local/bin which (a) requires sudo
    # and (b) doesn't exist on Apple Silicon. Install into Homebrew's bin
    # directory instead, which is already on PATH.
    GF_PREFIX="$(brew --prefix)/bin"
    mkdir -p "${GF_PREFIX}"
    for tool in branch merge pull push; do
        curl -fsSL "https://raw.githubusercontent.com/git-friendly/git-friendly/main/${tool}" \
            -o "${GF_PREFIX}/${tool}" \
            && chmod +x "${GF_PREFIX}/${tool}"
    done
    [[ $? ]] && e_success "Done"

    # ----- mtr setuid (run without sudo) -----
    mtr_prefix="$(brew --prefix mtr 2>/dev/null)"
    if [[ -x "${mtr_prefix}/sbin/mtr" ]]; then
        sudo chown root "${mtr_prefix}/sbin/mtr"
        sudo chmod 4755 "${mtr_prefix}/sbin/mtr"
    fi

    # ----- dnsmasq -----
    e_header "Setting up dnsmasq..."
    mkdir -p "${BREW_PREFIX}/etc"
    dnsmasqConf="${BREW_PREFIX}/etc/dnsmasq.conf"
    touch "${dnsmasqConf}"

    # idempotent: only append if line not already present
    for tld in develop work localhost; do
        line="address=/.${tld}/127.0.0.1"
        grep -qxF "${line}" "${dnsmasqConf}" || echo "${line}" >>"${dnsmasqConf}"
    done

    # install launch daemon
    if [[ ! -f /Library/LaunchDaemons/homebrew.mxcl.dnsmasq.plist ]]; then
        sudo cp -v "$(brew --prefix dnsmasq)/homebrew.mxcl.dnsmasq.plist" /Library/LaunchDaemons/
        sudo launchctl load -w /Library/LaunchDaemons/homebrew.mxcl.dnsmasq.plist
    fi

    # resolvers
    sudo mkdir -p /etc/resolver
    for tld in develop work localhost; do
        resolver="/etc/resolver/${tld}"
        if [[ ! -f "${resolver}" ]] || ! grep -qxF "nameserver 127.0.0.1" "${resolver}"; then
            sudo sh -c "echo 'nameserver 127.0.0.1' > ${resolver}"
        fi
    done

    # flush dns cache (modern macOS)
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder 2>/dev/null || true

    [[ $? ]] && e_success "Done"

    # ----- misc -----
    mkdir -p "${HOME}/bin"

    # pygments syntax highlighter (PEP 668-safe)
    if ! command -v pygmentize >/dev/null 2>&1; then
        if command -v pipx >/dev/null 2>&1; then
            pipx install pygments
        else
            brew install pygments
        fi
    fi

    # diff-so-fancy as default git pager
    git config --global core.pager "diff-so-fancy | less --tabs=4 -RFX"
}
