#!/bin/bash

run_cask() {
    # Check for Homebrew
    if type_exists 'brew'; then

        # Specify your defaults in this environment variable
        export HOMEBREW_CASK_OPTS="--appdir=/Applications"

        e_header "Checking status of desired Casks ..."
        local list_casks
        local -a missing_casks
        # Snapshot of `brew list --cask` mirrored back into the dotfiles.
        # TODO markers flag casks that look unused (no last-used date in
        # Spotlight metadata) — review periodically.
        local -a desired_casks=(
            # daily
            'rectangle'
            'alfred'
            'bartender'
            'homerow'
            'slack'
            'sublime-text'

            # dev
            'visual-studio-code'
            #'zed'                 # TODO: actually used?
            #'ghostty'             # TODO: actually used?
            'orbstack'
            'postman'
            'figma'
            'obsidian'
            'imageoptim'          # TODO: usage tracker null
            #'responsively'        # TODO: usage tracker null
            #'memoryanalyzer'      # TODO: usage tracker null
            'transmit'            # TODO: usage tracker null

            # browsers
            'google-chrome'
            'google-chrome@canary'
            'firefox'
            'vivaldi'
            'brave-browser'       # TODO: usage tracker null
            'microsoft-edge'      # TODO: usage tracker null
            # 'chromium'          # TODO: phantom — cask installed but app missing

            # graphics / video
            #'sketch'              # TODO: usage tracker null
            'handbrake-app'       # TODO: usage tracker null
            #'vlc'                 # TODO: usage tracker null
            #'kap'                 # TODO: usage tracker null
            'licecap'             # TODO: usage tracker null
            'clipgrab'            # TODO: usage tracker null
            #'zeplin'              # TODO: usage tracker null

            # tooling / utilities
            'gpg-suite'
            'mitmproxy'
            'ngrok'
            'betterzip'           # TODO: usage tracker null
            'blackhole-2ch'

            # JDK
            'temurin@21'

            # Quick Look plugins
            'qlmarkdown'
            'suspicious-package'
        )

        for index in ${!desired_casks[*]}; do
            if ! cask_exists ${desired_casks[$index]}; then
                missing_casks+=("${desired_casks[$index]}")
            fi
        done

        if [[ ${#missing_casks[@]} -gt 0 ]]; then
            e_header "Installing ${#missing_casks[@]} missing Homebrew cask(s)..."
            local -a failed_casks=()
            for cask in "${missing_casks[@]}"; do
                if ! brew install --cask "$cask"; then
                    e_warning "Failed to install cask: $cask"
                    failed_casks+=("$cask")
                fi
            done
            if [[ ${#failed_casks[@]} -gt 0 ]]; then
                e_warning "Skipped (review lib/cask): ${failed_casks[*]}"
            else
                e_success "Done"
            fi
        fi
    else
        printf "\n"
        e_error "Error: Homebrew not found."
        printf "Aborting...\n"
        exit
    fi
}
