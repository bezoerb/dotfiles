# Machine-local shell environment.
#
# Copied to ~/.localrc on first run; sourced by .zshrc.
# This file is intentionally NOT tracked by git — put secrets and
# machine-specific overrides here only.

# Homebrew
export HOMEBREW_CASK_OPTS="--appdir=~/Applications"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

